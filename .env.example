# Where contact briefs are delivered. Any endpoint that accepts a JSON POST:
# Formspree, a Zapier or Make webhook, a Slack incoming webhook, or your own API.
# Until this is set, the form reports that delivery is not configured yet.
CONTACT_WEBHOOK_URL=

# Canonical origin used by app/sitemap.ts and app/robots.ts.
# Unset locally: both fall back to https://masabur-sifat.vercel.app.
NEXT_PUBLIC_SITE_URL=
